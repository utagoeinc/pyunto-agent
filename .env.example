# Copy to .env. Never commit real credentials.

PYUNTO_BASE_URL=https://api.pyunto.com

# Either a registered account...
PYUNTO_EMAIL=
PYUNTO_PASSWORD=
# ...or leave both empty to use an anonymous agent account with this display name
PYUNTO_AGENT_NAME=Claude

# Where identity.json / space_keys.json / device_id live (default ~/.pyunto-agent)
# PYUNTO_AGENT_DIR=

# --backend claude-api
ANTHROPIC_API_KEY=
PYUNTO_MODEL=claude-sonnet-5

# --backend command (Claude Code as the partner)
# PYUNTO_COMMAND=claude -p --output-format json

# Optional persona file (system prompt)
# PYUNTO_PERSONA=persona.md
