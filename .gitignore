# Live credentials. .agent-data holds identity.json -- the agent's X25519 private key, which
# is what member apps seal space keys to. Committing it would hand anyone who clones the repo
# the ability to impersonate this agent and read every diary it belongs to.
.agent-data/
.env

# Virtualenv and build output: large, machine-specific, and regenerated by any install.
.venv/
build/
dist/
*.egg-info/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# macOS
.DS_Store
